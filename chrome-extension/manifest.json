{
  "manifest_version": 3,
  "name": "Sapo Tab Capture",
  "version": "0.1.0",
  "description": "Capture tab audio for Sapo recording",
  "key": "",
  "permissions": [
    "tabCapture",
    "tabs",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "offscreen": {
    "document": "offscreen.html"
  }
}
